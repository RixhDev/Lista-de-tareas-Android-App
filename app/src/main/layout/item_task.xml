<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:backgroundTint="@color/background_dark_blue"
    app:cardElevation="6dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/accent_magenta"
    app:strokeWidth="1.5dp"
    android:outlineSpotShadowColor="@color/accent_magenta"
    android:outlineAmbientShadowColor="@color/accent_magenta">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Icono de la tarea -->

        <!-- Nombre de la tarea -->

        <!-- Hora de la tarea -->

        <ImageView
            android:id="@+id/img_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            tools:layout_editor_absoluteX="27dp"
            tools:layout_editor_absoluteY="16dp" />

        <TextView
            android:id="@+id/txt_name"
            app:layout_constraintEnd_toStartOf="@id/chk_done"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/img_icon"
            app:layout_constraintTop_toTopOf="@id/img_icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nombre de tarea"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="35dp"
            tools:layout_editor_absoluteY="79dp" />

        <TextView
            android:id="@+id/txt_hora"
            app:layout_constraintStart_toStartOf="@id/txt_name"
            app:layout_constraintTop_toBottomOf="@id/txt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"
            android:textColor="@color/text_whitesmoke"
            android:textSize="14sp"
            tools:layout_editor_absoluteX="198dp"
            tools:layout_editor_absoluteY="84dp" />

        <TextView
            android:id="@+id/txt_compra_details"
            app:layout_constraintStart_toEndOf="@id/txt_hora"
            app:layout_constraintTop_toTopOf="@id/txt_hora"
            app:layout_constraintBottom_toBottomOf="@id/txt_hora"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cant: 2 - $500"
            android:textColor="@color/detail_cyan"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible"/>

        <CheckBox
            android:id="@+id/chk_done"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hecha"
            android:textColor="@color/text_white"
            tools:layout_editor_absoluteX="256dp"
            tools:layout_editor_absoluteY="69dp" />

        <RatingBar
            android:id="@+id/rating_priority"
            app:layout_constraintStart_toStartOf="@id/txt_name"
            app:layout_constraintTop_toBottomOf="@id/txt_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:isIndicator="false"
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:transformPivotX="0dp"
            tools:rating="3" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
